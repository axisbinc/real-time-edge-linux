    /**/
    /*     simple-audio-card,codec { */
    /*         sound-dai = <&tas5825m_10>; */
    /*     }; */
    /* }; */

    /* TAS5825M #11: Channels 22-23 (TDM slots 6-7 on TX_DATA1) */
    /* sound-amp-11 { */
    /*     compatible = "simple-audio-card"; */
    /*     simple-audio-card,name = "tas5825m-ch22-23"; */
    /*     simple-audio-card,format = "dsp_a"; */
    /*     simple-audio-card,bitclock-master = <&cpu_amp_11>; */
    /*     simple-audio-card,frame-master = <&cpu_amp_11>; */
    /*     status = "okay"; */
    /**/
    /*     cpu_amp_11: simple-audio-card,cpu { */
    /*         sound-dai = <&sai2>; */
    /*         dai-tdm-slot-num = <32>; */
    /*         dai-tdm-slot-width = <32>; */
    /*         dai-tdm-slot-tx-mask = <0x00C00000>; /* Slots 6-7 on TX_DATA1 */ 
    /*     }; */
    /**/
    /*     simple-audio-card,codec { */
    /*         sound-dai = <&tas5825m_11>; */
    /*     }; */
    /* }; */

    /* TAS5825M #12: Channels 24-25 (TDM slots 8-9 on TX_DATA1) */
    /* sound-amp-12 { */
    /*     compatible = "simple-audio-card"; */
    /*     simple-audio-card,name = "tas5825m-ch24-25"; */
    /*     simple-audio-card,format = "dsp_a"; */
    /*     simple-audio-card,bitclock-master = <&cpu_amp_12>; */
    /*     simple-audio-card,frame-master = <&cpu_amp_12>; */
    /*     status = "okay"; */
    /**/
    /*     cpu_amp_12: simple-audio-card,cpu { */
    /*         sound-dai = <&sai2>; */
    /*         dai-tdm-slot-num = <32>; */
    /*         dai-tdm-slot-width = <32>; */
    /*         dai-tdm-slot-tx-mask = <0x03000000>; /* Slots 8-9 on TX_DATA1 */ 
    /*     }; */
    /**/
    /*     simple-audio-card,codec { */
    /*         sound-dai = <&tas5825m_12>; */
    /*     }; */
    /* }; */

    /* TAS5825M #13: Channels 26-27 (TDM slots 10-11 on TX_DATA1) */
    /* sound-amp-13 { */
    /*     compatible = "simple-audio-card"; */
    /*     simple-audio-card,name = "tas5825m-ch26-27"; */
    /*     simple-audio-card,format = "dsp_a"; */
    /*     simple-audio-card,bitclock-master = <&cpu_amp_13>; */
    /*     simple-audio-card,frame-master = <&cpu_amp_13>; */
    /*     status = "okay"; */
    /**/
    /*     cpu_amp_13: simple-audio-card,cpu { */
    /*         sound-dai = <&sai2>; */
    /*         dai-tdm-slot-num = <32>; */
    /*         dai-tdm-slot-width = <32>; */
    /*         dai-tdm-slot-tx-mask = <0x0C000000>; /* Slots 10-11 on TX_DATA1 */ 
    /*     }; */
    /**/
    /*     simple-audio-card,codec { */
    /*         sound-dai = <&tas5825m_13>; */
    /*     }; */
    /* }; */

    /* TAS5825M #14: Channels 28-29 (TDM slots 12-13 on TX_DATA1) */
    /* sound-amp-14 { */
    /*     compatible = "simple-audio-card"; */
    /*     simple-audio-card,name = "tas5825m-ch28-29"; */
    /*     simple-audio-card,format = "dsp_a"; */
    /*     simple-audio-card,bitclock-master = <&cpu_amp_14>; */
    /*     simple-audio-card,frame-master = <&cpu_amp_14>; */
    /*     status = "okay"; */
    /**/
    /*     cpu_amp_14: simple-audio-card,cpu { */
    /*         sound-dai = <&sai2>; */
    /*         dai-tdm-slot-num = <32>; */
    /*         dai-tdm-slot-width = <32>; */
    /*         dai-tdm-slot-tx-mask = <0x30000000>; /* Slots 12-13 on TX_DATA1 */ 
    /*     }; */
    /**/
    /*     simple-audio-card,codec { */
    /*         sound-dai = <&tas5825m_14>; */
    /*     }; */
    /* }; */

    /* TAS5825M #15: Channels 30-31 (TDM slots 14-15 on TX_DATA1) */
    /* sound-amp-15 { */
    /*     compatible = "simple-audio-card"; */
    /*     simple-audio-card,name = "tas5825m-ch30-31"; */
    /*     simple-audio-card,format = "dsp_a"; */
    /*     simple-audio-card,bitclock-master = <&cpu_amp_15>; */
    /*     simple-audio-card,frame-master = <&cpu_amp_15>; */
    /*     status = "okay"; */
    /**/
    /*     cpu_amp_15: simple-audio-card,cpu { */
    /*         sound-dai = <&sai2>; */
    /*         dai-tdm-slot-num = <32>; */
    /*         dai-tdm-slot-width = <32>; */
    /*         dai-tdm-slot-tx-mask = <0xC0000000>; /* Slots 14-15 on TX_DATA1 */ 
    /*     }; */
    /**/
    /*     simple-audio-card,codec { */
    /*         sound-dai = <&tas5825m_15>; */
    /*     }; */
    /* }; */
};

&dsp {
	compatible = "fsl,imx8mp-hifi4";
	reg = <0x0 0x3B6E8000 0x0 0x88000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_OCRAMA_IPG>,
			 <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_DSP_ROOT>,
			 <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_DSPDBG_ROOT>,
			 <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_SDMA3_ROOT>,
			 <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_ASRC_IPG>,
			 <&clk IMX8MP_CLK_UART4_ROOT>;
	clock-names = "ocram", "core", "debug",
				  "per_clk1", "per_clk2", "per_clk3",
                  "per_clk5", "per_clk7";
	firmware-name = "imx/dsp/hifi4.bin";
	power-domains = <&audiomix_pd>;
	mbox-names = "tx0", "rx0", "rxdb0";
	mboxes = <&mu2 0 0>,
			 <&mu2 1 0>,
			 <&mu2 3 0>;
	memory-region = <&dsp_vdev0buffer>, <&dsp_vdev0vring0>,
					<&dsp_vdev0vring1>, <&dsp_reserved>;
	syscon = <&audio_blk_ctrl>;
	status = "okay";
};

/* Disable conflicting peripherals from symphony base */
&uart3 {
	status = "disabled";
};

&ecspi2 {
	status = "disabled";
};

&uart4 {
	status = "disabled";
};

&wm8904 {
	status = "disabled";
};

&pcie {
    status = "disabled";
};

&pcie_ep {
    status = "disabled";
};

&sound_hdmi {
	status = "disabled";
};

&aud2htx {
	status = "disabled";
};

&flexcan2 {
	status = "disabled";
};

&irqsteer_hdmi {
	status = "disabled";
};

&hdmi_blk_ctrl {
	status = "disabled";
};

&hdmi_pavi {
	status = "disabled";
};

&hdmi {
	status = "disabled";
};

&hdmiphy {
	status = "disabled";
};

/* MIPI-DSI */
&lcdif1 {
	status = "disabled";
};

/* LVDS */
&lcdif2 {
	status = "disabled";
};

/* HDMI */
&lcdif3 {
	status = "disabled";
};

&ldb {
	status = "disabled";
};

&ldb_phy {
	status = "disabled";
};

&mipi_dsi {
	status = "disabled";
};

/* Force FEC ethernet to 100 Mbps */
&fec {
	max-speed = <100>;
};

/* Also limit the PHY to 100 Mbps */
&ethphy1 {
	max-speed = <100>;
};
